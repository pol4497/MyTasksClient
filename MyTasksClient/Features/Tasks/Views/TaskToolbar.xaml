<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MyTasksClient.Features.Tasks.ViewModels"
             x:Class="MyTasksClient.Features.Tasks.Views.TaskToolbar"
             x:DataType="vm:TaskQueryViewModel">

    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <SearchBar Text="{Binding SearchText}"
                   Placeholder="Search tasks"
                   SearchCommand="{Binding SearchNowCommand}"
                   SemanticProperties.Hint="Search tasks by title or description" />

        <Button Grid.Column="1"
                Text="Filter &amp; sort"
                Style="{StaticResource SecondaryButton}"
                Command="{Binding TogglePanelCommand}"
                VerticalOptions="Center"
                SemanticProperties.Hint="Show or hide filter, sort and paging options" />
    </Grid>
</ContentView>